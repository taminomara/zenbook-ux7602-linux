#!/bin/sh
# Toggle the touchpad under niri, which has no runtime toggle action: flip a
# one-line config include and let niri reload it. While off, this section
# replaces the one in input.kdl, so it must be included after input.kdl.
state_file=${XDG_CONFIG_HOME:-$HOME/.config}/niri/cfg/touchpad-state.kdl
off='input { touchpad { off; }; }'
if grep -qxF "$off" "$state_file" 2>/dev/null; then
    printf '// Written by touchpad-toggle; "%s" disables it.\n' "$off" > "$state_file"
    state=enabled
else
    printf '%s\n' "$off" > "$state_file"
    state=disabled
fi
if command -v noctalia >/dev/null; then
    noctalia msg notification-show Touchpad "$state"
else
    notify-send -a Touchpad Touchpad "$state"
fi
