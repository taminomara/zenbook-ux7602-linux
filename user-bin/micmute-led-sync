#!/bin/sh
# Keep the mic-mute key LED in sync with the default PipeWire source's mute state.
# pactl output is localised; match it in C so "yes" and "on source" are stable.
export LC_ALL=C

sync_led() {
    if pactl get-source-mute @DEFAULT_SOURCE@ | grep -q yes; then v=1; else v=0; fi
    brightnessctl -q -d platform::micmute set "$v"
}

sync_led
pactl subscribe | while read -r line; do
    case $line in
        *"on source"*|*"on server"*) sync_led ;;
    esac
done
# pactl subscribe only returns when the server went away (restart, crash, or
# not up yet at login). A pipeline's status is the loop's, i.e. 0, which
# Restart=on-failure would not restart; exit non-zero so systemd brings us back.
echo "micmute-led-sync: pactl subscription ended, exiting for restart" >&2
exit 1
