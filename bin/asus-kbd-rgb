#!/usr/bin/python3 -I
"""Keyboard backlight control for the ASUS Zenbook UX7602 (USB 0B05:8854).

The firmware only accepts lighting commands as feature reports on USB
interface 0, which the kernel's asus::kbd_backlight LED doesn't use, so talk
to that interface's hidraw node directly. Protocol from Novaryu/zenauracore.

Usage: asus-kbd-rgb cycle | up | down | brightness 0-3 | color RRGGBB
                    | sleep | wake | restore | status
"""
import fcntl, glob, json, os, re, sys, tempfile

NAME = "asus-kbd-rgb"
STATE = "/var/lib/asus-ux7602/kbd-rgb.json"
DEFAULT = {"brightness": 1, "color": "ffffff"}


def hidraw_node(interface):
    """hidraw node of one USB interface of the keyboard, found by sysfs path
    (the HID instance number is a global counter and depends on probe order)."""
    for dev in glob.glob("/sys/bus/hid/devices/0003:0B05:8854.*"):
        if f":1.{interface}/" in os.path.realpath(dev) + "/":
            nodes = glob.glob(dev + "/hidraw/hidraw*")
            if nodes:
                return "/dev/" + os.path.basename(nodes[0])
    sys.exit(f"{NAME}: keyboard 0B05:8854 not found")


def hidiocsfeature(length):  # HIDIOCSFEATURE(length), see <linux/hidraw.h>
    return (3 << 30) | (length << 16) | (ord("H") << 8) | 0x06


def send(fd, *data):
    buf = bytearray(64)
    buf[: len(data)] = bytes(data)
    fcntl.ioctl(fd, hidiocsfeature(64), buf)


def apply(brightness=None, color=None):
    fd = os.open(hidraw_node(0), os.O_RDWR)
    try:
        send(fd, 0x5A, *b"ASUS Tech.Inc.")
        if color is not None:
            r, g, b = bytes.fromhex(color)
            send(fd, 0x5C, 0xA0, 0, 0, r, g, b)
            send(fd, 0x5C, 0xA5, 0, 0, r, g, b)
        if brightness is not None:
            send(fd, 0x5A, 0xBA, 0xC5, 0xC4, brightness)
    finally:
        os.close(fd)


def load():
    try:
        with open(STATE) as f:
            s = json.load(f)
        if s["brightness"] in range(4) and re.fullmatch("[0-9a-f]{6}", s["color"]):
            return s
    except (OSError, ValueError, KeyError, TypeError):
        pass
    return dict(DEFAULT)


def save(s):
    d = os.path.dirname(STATE)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".state.")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(s, f)
        os.replace(tmp, STATE)
    except BaseException:
        os.unlink(tmp)
        raise


def locked():
    """Serialise load-modify-save across overlapping runs (a held key bind
    repeating "cycle" can start the next run before the first has saved)."""
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    fd = os.open(STATE + ".lock", os.O_RDWR | os.O_CREAT, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def main(argv):
    lock = locked()
    s = load()
    cmd = argv[0] if argv else ""
    arg = argv[1] if len(argv) > 1 else ""

    if cmd == "status":
        pass
    elif cmd == "sleep":  # lights off without forgetting the setting
        apply(brightness=0)
        return
    elif cmd == "wake":
        # The firmware comes back from suspend at the level last chosen with
        # Fn+F7, which we can't read; only re-initialise, don't override it.
        apply()
        return
    elif cmd == "restore":
        apply(s["brightness"], s["color"])
    elif cmd == "cycle":
        s["brightness"] = (s["brightness"] + 1) % 4
    elif cmd == "up":
        s["brightness"] = min(3, s["brightness"] + 1)
    elif cmd == "down":
        s["brightness"] = max(0, s["brightness"] - 1)
    elif cmd == "brightness" and re.fullmatch("[0-3]", arg):
        s["brightness"] = int(arg)
    elif cmd == "color" and re.fullmatch("[0-9a-fA-F]{6}", arg):
        s["color"] = arg.lower()
    else:
        sys.exit(__doc__.strip())

    if cmd not in ("status", "restore"):
        apply(s["brightness"], s["color"])
        save(s)
    print(s["brightness"], s["color"])


if __name__ == "__main__":
    main(sys.argv[1:])
